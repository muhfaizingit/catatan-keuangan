# Copy file ini ke /opt/keuangan/.env dan isi nilai nyata.
# JANGAN commit .env ke git (sudah di-ignore).

DB_HOST=localhost
DB_PORT=3306
DB_NAME=keuangan
DB_USER=admin
DB_PASS=PASSWORD_KUAT_DB

# Ganti dengan string acak panjang (min 32 karakter).
JWT_SECRET=ganti-dengan-string-acak-sangat-panjang-dan-unik

APP_PORT=8080
APP_ENV=production

SEED_ADMIN_EMAIL=admin@sekolah.id
SEED_ADMIN_PASSWORD=password_admin_yang_kuat
SEED_ADMIN_NAMA=Administrator
